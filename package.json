{
  "name": "rich-wind",
  "version": "0.0.1-alpha.0",
  "description": "A stateless Tailwind CSS runtime service for compiling CSS from HTML and class lists",
  "type": "module",
  "main": "./services/index.js",
  "types": "./services/index.d.ts",
  "exports": {
    ".": {
      "types": "./services/index.d.ts",
      "import": "./services/index.js",
      "default": "./services/index.js"
    },
    "./plugins/auto-promote": {
      "import": "./plugins/auto-promote/index.js",
      "default": "./plugins/auto-promote/index.js"
    },
    "./plugins/cache-store-fs": {
      "import": "./plugins/cache-store-fs/index.js",
      "default": "./plugins/cache-store-fs/index.js"
    }
  },
  "files": [
    "services/",
    "plugins/auto-promote/",
    "plugins/cache-store-fs/"
  ],
  "workspaces": [
    "lexical-demo"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node ./services/index.js",
    "dev": "node --watch ./services/index.js",
    "dev:lexical": "node --watch ./lexical-demo/scripts/dev-server.js",
    "dev:lexical-ui": "npm run dev --workspace=lexical-demo",
    "build:lexical-demo": "npm run build --workspace=lexical-demo",
    "prod": "node ./services/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "node ./scripts/clean-package.js clean",
    "postpack": "node ./scripts/clean-package.js restore",
    "test:pack": "node ./scripts/pack-smoke.js",
    "test:load": "node ./scripts/load-single-writer.js"
  },
  "keywords": [
    "tailwindcss",
    "tailwind",
    "css",
    "runtime",
    "compiler",
    "api",
    "service"
  ],
  "author": "Farooq Alaulddin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FarooqAlaulddin/rich-wind.git"
  },
  "dependencies": {
    "@tailwindcss/node": "^4.1.18",
    "@tailwindcss/oxide": "^4.1.18",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "vitest": "^4.0.18"
  }
}
