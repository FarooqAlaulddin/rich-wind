{
  "openapi": "3.1.0",
  "info": {
    "title": "Rich Wind API",
    "version": "1.0.0",
    "description": "Runtime Tailwind CSS compilation and cache API. Every documented endpoint may be blocked by a plugin guard: 401 uses UNAUTHORIZED, 403 uses FORBIDDEN, 429 uses RATE_LIMITED, and other blocking statuses use REQUEST_BLOCKED."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development"
    }
  ],
  "paths": {
    "/api/compile": {
      "post": {
        "summary": "Compile and cache page CSS",
        "description": "Compiles Tailwind CSS from html/classes and caches by projectId + pageId.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompileRequest"
              },
              "examples": {
                "compile_full": {
                  "value": {
                    "projectId": "my-app",
                    "pageId": "home",
                    "html": "<main class=\"p-6 text-red-500\">Hello</main>",
                    "classes": [
                      "rounded-lg",
                      "shadow-sm"
                    ],
                    "bundle": "full"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compilation completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompileSuccessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Replica is read-only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadOnlyErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload or input too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Blocked by a plugin guard (RATE_LIMITED); core has no built-in limiter",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Seconds until the next allowed request."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Every compile slot is in use (SERVER_BUSY); the compile is shed without queueing",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Seconds to wait before retrying. Always 1."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/css": {
      "get": {
        "summary": "Get cached page CSS",
        "description": "Reads CSS for a cached page. Returns text/css when found.",
        "parameters": [
          {
            "$ref": "#/components/parameters/projectId"
          },
          {
            "$ref": "#/components/parameters/pageId"
          },
          {
            "$ref": "#/components/parameters/bundle"
          }
        ],
        "responses": {
          "200": {
            "description": "CSS found",
            "headers": {
              "ETag": {
                "description": "Hash of the compiled class set. Send as If-None-Match for 304 revalidation.",
                "schema": { "type": "string" }
              },
              "Cache-Control": {
                "description": "no-cache — revalidate before use",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "text/css": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified — CSS unchanged since If-None-Match"
          },
          "404": {
            "description": "Cached CSS not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{projectId}/css": {
      "get": {
        "summary": "Get aggregated project CSS",
        "description": "Returns a project-wide stylesheet built from the union of cached page classes.",
        "parameters": [
          {
            "$ref": "#/components/parameters/projectIdPath"
          },
          {
            "$ref": "#/components/parameters/bundle"
          }
        ],
        "responses": {
          "200": {
            "description": "Project CSS found",
            "headers": {
              "ETag": {
                "description": "Hash of the compiled class set. Send as If-None-Match for 304 revalidation.",
                "schema": { "type": "string" }
              },
              "Cache-Control": {
                "description": "no-cache — revalidate before use",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "text/css": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified — CSS unchanged since If-None-Match"
          },
          "404": {
            "description": "Project CSS not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/invalidate": {
      "post": {
        "summary": "Invalidate cached CSS",
        "description": "Immediately purges a page or entire project from the in-memory cache and persistent cache store. Not allowed on reader nodes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvalidateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invalidation successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "Read-only replica — route writes to a writer node",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/suggest": {
      "post": {
        "summary": "Suggest Tailwind classes",
        "description": "Returns class suggestions from provided classes, project cache, and optional fallback data.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SuggestRequest"
              },
              "examples": {
                "suggest_bg": {
                  "value": {
                    "projectId": "my-app",
                    "prefix": "bg-",
                    "limit": 10
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Suggestions returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/richwind-loader.js": {
      "get": {
        "summary": "Get optional browser loader",
        "description": "Returns an optional JavaScript helper for plain HTML preview surfaces. The loader attaches shared Rich Wind stylesheets and compiles body utilities in browser contexts.",
        "responses": {
          "200": {
            "description": "Browser loader JavaScript",
            "content": {
              "application/javascript": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/richwind-reload.js": {
      "get": {
        "summary": "Get optional reload helper",
        "description": "Returns the optional JavaScript helper that injects a fixed reload button into local or static HTML preview surfaces.",
        "responses": {
          "200": {
            "description": "Reload helper JavaScript",
            "content": {
              "application/javascript": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "projectId": {
        "name": "projectId",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/ProjectId"
        },
        "description": "Project identifier."
      },
      "pageId": {
        "name": "pageId",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/PageId"
        },
        "description": "Page identifier. Defaults to \"default\"."
      },
      "projectIdPath": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/ProjectId"
        }
      },
      "bundle": {
        "name": "bundle",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/Bundle"
        }
      }
    },
    "schemas": {
      "ProjectId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9._-]+$",
        "maxLength": 64
      },
      "PageId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9._-]+$",
        "maxLength": 64
      },
      "Bundle": {
        "type": "string",
        "enum": [
          "full",
          "base",
          "theme",
          "utilities"
        ]
      },
      "NormalizedBundle": {
        "type": "string",
        "enum": [
          "full",
          "base",
          "theme",
          "utilities"
        ]
      },
      "ClassInput": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      },
      "CompileRequest": {
        "type": "object",
        "properties": {
          "projectId": {
            "$ref": "#/components/schemas/ProjectId"
          },
          "pageId": {
            "$ref": "#/components/schemas/PageId",
            "default": "default"
          },
          "html": {
            "type": "string"
          },
          "classes": {
            "$ref": "#/components/schemas/ClassInput"
          },
          "bundle": {
            "$ref": "#/components/schemas/Bundle"
          }
        },
        "allOf": [
          {
            "anyOf": [
              {
                "required": [
                  "projectId"
                ]
              }
            ]
          },
          {
            "anyOf": [
              {
                "required": [
                  "html"
                ]
              },
              {
                "required": [
                  "classes"
                ]
              },
              {
                "properties": {
                  "bundle": {
                    "enum": ["base"]
                  }
                },
                "required": [
                  "bundle"
                ]
              }
            ]
          }
        ]
      },
      "CompileSuccessResponse": {
        "type": "object",
        "required": [
          "success",
          "projectId",
          "pageId",
          "bundle",
          "hash",
          "classes",
          "rejected",
          "cached",
          "css"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "projectId": {
            "$ref": "#/components/schemas/ProjectId"
          },
          "pageId": {
            "$ref": "#/components/schemas/PageId"
          },
          "bundle": {
            "$ref": "#/components/schemas/NormalizedBundle"
          },
          "hash": {
            "type": "string"
          },
          "classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rejected": {
            "type": "array",
            "description": "Invalid or unsafe normalized tokens from explicit classes input only.",
            "items": {
              "type": "string"
            }
          },
          "cached": {
            "type": "boolean"
          },
          "css": {
            "type": "string"
          }
        }
      },
      "SuggestRequest": {
        "type": "object",
        "properties": {
          "projectId": {
            "$ref": "#/components/schemas/ProjectId"
          },
          "prefix": {
            "type": "string"
          },
          "classes": {
            "$ref": "#/components/schemas/ClassInput"
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "SuggestResponse": {
        "type": "object",
        "required": [
          "success",
          "projectId",
          "prefix",
          "count",
          "suggestions"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "projectId": {
            "type": [
              "string",
              "null"
            ]
          },
          "prefix": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "suggestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "InvalidateRequest": {
        "type": "object",
        "required": ["projectId"],
        "properties": {
          "projectId": {
            "$ref": "#/components/schemas/ProjectId"
          },
          "pageId": {
            "$ref": "#/components/schemas/PageId",
            "description": "When omitted, the entire project is purged"
          }
        }
      },
      "InvalidateResponse": {
        "type": "object",
        "required": ["invalidated", "projectId"],
        "properties": {
          "invalidated": {
            "type": "boolean",
            "const": true
          },
          "projectId": {
            "$ref": "#/components/schemas/ProjectId"
          },
          "pageId": {
            "$ref": "#/components/schemas/PageId",
            "description": "Present only when a single page was invalidated"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": ["INVALID_ID", "MISSING_INPUT", "INVALID_BODY", "UNSUPPORTED_MEDIA_TYPE", "PAYLOAD_TOO_LARGE", "READ_ONLY_REPLICA", "RATE_LIMITED", "SERVER_BUSY", "UNAUTHORIZED", "FORBIDDEN", "REQUEST_BLOCKED", "NOT_FOUND", "INTERNAL"]
          }
        }
      },
      "ReadOnlyErrorResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ErrorResponse"
          },
          {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "const": "READ_ONLY_REPLICA"
              }
            }
          }
        ]
      }
    }
  }
}
