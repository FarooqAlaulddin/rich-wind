# Install as /etc/rich-wind/rich-wind.env (mode 0640, group rich-wind).
# Values shown are the code defaults unless noted. Only variables the code reads.

# Listen port. The server binds all interfaces; restrict with a firewall.
PORT=3001
# Heap cap, kept below MemoryMax=768M in the unit.
NODE_OPTIONS=--max-old-space-size=512

# Hop count of trusted proxies in front of the app. 1 = nginx only; use 2 if
# another proxy sits between. A number is a hop count, "true" trusts every
# hop, a comma list is addresses or subnets. Unset: X-Forwarded-For ignored.
RW_TRUST_PROXY=1

# Max request body in bytes (minimum 1024).
RW_MAX_BODY_BYTES=100000
# Max HTML characters per compile.
RW_MAX_HTML_CHARS=50000
# Max concurrent compiles.
RW_MAX_CONCURRENT_COMPILES=8
# Max characters in a class list.
RW_MAX_CLASS_CHARS=10000
# Max number of classes per request.
RW_MAX_CLASS_COUNT=1500
# Max project or page id length.
RW_MAX_ID_LENGTH=64
# Max suggestions returned.
RW_SUGGEST_LIMIT=100
# Fall back to a broader suggestion search when no match (true or false).
RW_SUGGEST_FALLBACK=true
# Max compiled CSS characters.
RW_MAX_CSS_CHARS=2000000
# Max pages held in the in-memory cache.
RW_CACHE_MAX_PAGES=200
# Page cache TTL in milliseconds.
RW_CACHE_TTL_MS=600000
# Project cache TTL in milliseconds (defaults to RW_CACHE_TTL_MS).
RW_PROJECT_CACHE_TTL_MS=600000
# Cache store call timeout in milliseconds.
RW_CACHE_STORE_TIMEOUT_MS=150
# Plugin hook timeout in milliseconds.
RW_PLUGIN_TIMEOUT_MS=200
# Node role: hybrid, writer or reader.
RW_NODE_ROLE=hybrid
# CORS: * or comma-separated origins. Unset: CORS headers off.
#RW_CORS_ORIGIN=https://example.com
